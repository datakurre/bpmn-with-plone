        <bpmn:flowNodeRef>Gateway_1hayhic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0pqm8gl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_Submit" sourceRef="Task_CreateDraft" targetRef="Event_1yy2gbd" />
    <bpmn:sequenceFlow id="Flow_1lmaaal" sourceRef="Event_1yy2gbd" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Approved" name="yes" sourceRef="Gateway_Approved" targetRef="EndEvent_Published" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_Review" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="no" sourceRef="Gateway_Approved" targetRef="Event_0w25drc" />
    <bpmn:sequenceFlow id="Flow_0otltv8" sourceRef="Event_0w25drc" targetRef="Gateway_1hayhic" />
