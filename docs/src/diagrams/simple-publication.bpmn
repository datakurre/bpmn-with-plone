    <bpmn:sequenceFlow id="Flow_MergeToDraft" sourceRef="Gateway_MergeDraft" targetRef="Task_CreateDraft" />
    <bpmn:sequenceFlow id="Flow_StartToDraft" sourceRef="StartEvent_1" targetRef="Gateway_MergeDraft" />
    <bpmn:intermediateThrowEvent id="Event_1yy2gbd" name="Submit">
      <bpmn:incoming>Flow_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_1lmaaal</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_198ntba" camunda:type="external" camunda:topic="submit" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_Published" name="Publish">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0w1py80" camunda:type="external" camunda:topic="publish" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Was approved?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review" name="Review">
      <bpmn:incoming>Flow_1lmaaal</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_0w25drc" name="Reject">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_0otltv8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_03f8qjh" camunda:type="external" camunda:topic="reject" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_1hayhic">
      <bpmn:incoming>Flow_0otltv8</bpmn:incoming>
