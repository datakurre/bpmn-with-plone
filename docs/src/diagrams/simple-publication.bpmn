  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_SimplePublication" name="Simple Publication" processRef="Process_SimplePublication" />
    <bpmn:participant id="Participant_1ndvnor" name="Plone CMS" />
    <bpmn:messageFlow id="Flow_1t21w7f" name="reject" sourceRef="Event_0w25drc" targetRef="Participant_1ndvnor" />
    <bpmn:messageFlow id="Flow_1wco4qc" name="submit" sourceRef="Event_1yy2gbd" targetRef="Participant_1ndvnor" />
    <bpmn:messageFlow id="Flow_1rwkoji" name="retract" sourceRef="Participant_1ndvnor" targetRef="Event_0pqm8gl" />
    <bpmn:messageFlow id="Flow_1dslh1n" name="publish" sourceRef="EndEvent_Published" targetRef="Participant_1ndvnor" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SimplePublication" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Creator" name="Author">
        <bpmn:flowNodeRef>Event_1yy2gbd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reviewer" name="Reviewer">
