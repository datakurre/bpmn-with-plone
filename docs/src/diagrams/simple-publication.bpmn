      <bpmn:outgoing>Flow_1lkdacd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CreateDraft" name="Create draft&#10;and submit it">
      <bpmn:incoming>Flow_MergeToDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeDraft">
      <bpmn:incoming>Flow_StartToDraft</bpmn:incoming>
      <bpmn:incoming>Flow_1lkdacd</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToDraft</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_StartToDraft</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:boundaryEvent id="Event_0pqm8gl" name="Retract" attachedToRef="Task_Review">
      <bpmn:outgoing>Flow_0o16o0s</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_08zq5xy" />
    </bpmn:boundaryEvent>
  </bpmn:process>
